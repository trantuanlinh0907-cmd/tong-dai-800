# ===== Tong Dai 800 - Environment Variables =====
# Copy file nay thanh .env va dien gia tri that:
#   cp .env.example .env  (Linux/Mac)
#   copy .env.example .env (Windows)
# Sau do khoi dong lai server.

# ===== Server =====
# Port de chay server (mac dinh 3000)
PORT=3000

# ===== Facebook Webhook =====
# Verify token dung cho GET /webhook?hub.verify_token=...
# Phai khop voi gia tri da dang ky tren Facebook App Dashboard
VERIFY_TOKEN=tong_dai_800_verify_2024

# ===== Facebook Page Access Token =====
# BAT BUOC de gui tin nhan qua Facebook Messenger
# Lay tu: Facebook App > Messenger > Settings > Access Tokens
# Hoac dung System User Token neu can quyen cao hon
# Token phai co quyen: pages_messaging, pages_show_list
PAGE_ACCESS_TOKEN=

# Facebook Graph API version (mac dinh v19.0)
FB_API_VERSION=v19.0

# ===== OpenAI (cho AI brain) =====
# Neu rong se dung mock (khong goi OpenAI that)
OPENAI_API_KEY=
